{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/block-ai-attribution.sh\"; [ -x \"$f\" ] || exit 0; exec \"$f\""
          }
        ]
      }
    ]
  }
}
